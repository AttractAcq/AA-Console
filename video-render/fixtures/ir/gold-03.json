      "props": { "title": "Proof needs a clear source", "subtitle": "Keep the record connected", "kicker": "ATTRACT ACQUISITION" },
      "narration": "Useful proof starts with a clear source and a record of what can be used.",
      "transitionIn": "cut", "chapter": false, "locked": false
    },
    {
      "id": "s02", "component": "SectionCard",
      "props": { "index": 1, "title": "Capture the original" },
      "narration": "Keep the original quote, image, or outcome together with its date and context.",
      "transitionIn": "wipeBrand", "chapter": true, "locked": false
    },
    {
      "id": "s03", "component": "ProcessDiagram",
      "props": {
        "nodes": [
          { "id": "source", "label": "Source" },
          { "id": "rights", "label": "Rights" },
          { "id": "asset", "label": "Asset" },
          { "id": "review", "label": "Review" }
        ],
        "edges": [
          { "from": "source", "to": "rights" },
          { "from": "rights", "to": "asset" },
          { "from": "asset", "to": "review" }
        ]
