      "id": "s04", "component": "Quote",
      "props": { "text": "A citation is not clearance.", "attribution": "AA operating principle" },
      "narration": "A citation identifies the source. Permission and claim clearance are separate decisions.",
      "transitionIn": "slideLeft", "chapter": false, "locked": false
    },
