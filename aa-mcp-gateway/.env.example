HOST=127.0.0.1
PORT=3100
PUBLIC_ORIGIN=http://localhost:3100
DATABASE_PATH=./data/gateway.sqlite
# JSON arrays: inject unique, randomly generated >=32-character secrets. No default credentials.
BOT_CREDENTIALS_JSON=[]
REVIEWER_CREDENTIALS_JSON=[]
# Required pair to enable the live AA brief adapter; origin only, no trailing route.
# AA_INTERNAL_API_URL=https://aa-business-api.example.com
# AA_MCP_SERVICE_SECRET=

# Local/dev only: include stub (not_implemented) contracts in tools/list and allow call() by name.
# Default is false — Bots only discover and invoke executable (real/partial) tools they are permitted for.
# Does not change /mcp authentication. Leave unset in production.
# MCP_DISCOVER_STUBS=true

# Railway (inject variables; do not upload this local .env file):
# NODE_ENV=production
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://<gateway-public-domain>
# DATABASE_PATH=/data/gateway.sqlite
# Attach a persistent volume at /data, one replica only.
# RAILWAY_RUN_UID=0 (Railway volumes are root-owned; see docs/railway.md).
# Leave PORT to Railway.
