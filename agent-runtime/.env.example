# --- required ---
SUPABASE_URL=https://bancbdztffokwiifzoiv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# --- optional ---
AGENT_RUNTIME_ENABLED=true
AGENT_RUNTIME_CONCURRENCY=2
AGENT_RUNTIME_LEASE_SECONDS=900
AGENT_RUNTIME_EMPTY_QUEUE_BACKOFF_MS=5000
AGENT_RUNTIME_MODEL=claude-opus-5
AGENT_RUNTIME_SHARED_SECRET=
# Dedicated server-to-server MCP credential; absent means every MCP request is denied.
AA_MCP_SERVICE_SECRET=
PORT=8787

# --- creative build (optional) ---
# Without OPENAI_API_KEY the AI route reports itself unavailable rather than
# failing obscurely; the human route is unaffected.
OPENAI_API_KEY=
# The model ids are config because provider names change faster than this repo.
OPENAI_IMAGE_MODEL=gpt-image-2

# Which provider writes the creative concept (stage one of a build).
# openai uses CREATIVE_CONCEPT_MODEL; anthropic reuses AGENT_RUNTIME_MODEL.
CREATIVE_CONCEPT_PROVIDER=openai
CREATIVE_CONCEPT_MODEL=gpt-5.6-sol

# --- brief dispatch email (optional) ---
# Without RESEND_API_KEY a brief is still assigned and still lands on the
# person's dashboard; only the notification email is skipped.
RESEND_API_KEY=
RESEND_FROM=AA Console <briefs@attractacq.com>
# Where an emailed brief links back to.
CONSOLE_URL=https://console.attractacq.com

# --- bounds (optional) ---
# Per-request timeout for a model call. Without one the SDK waits forever, and
# a stalled stream hangs the job: lease renewal by a live worker keeps the
# lease fresh, so the expiry meant to recover it never fires.
AGENT_RUNTIME_PROVIDER_TIMEOUT_MS=600000
# How long a job may hold its lease before renewal stops and it becomes
# reclaimable. Must be longer than the lease and than the provider timeout.
AGENT_RUNTIME_MAX_JOB_SECONDS=1800

# Railway supplies PORT automatically; do not copy the local PORT override.
# Production deployment steps and integration prerequisites: RAILWAY.md
